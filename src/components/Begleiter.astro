---
import { trauben, traubenBox } from '../lib/logo';

/**
 * Der Begleiter: eine Rebe, die am linken Rand mitwächst, während man
 * scrollt. An jedem Abschnitt sitzt eine Traube, die reif wird, sobald man
 * dort ankommt — gleichzeitig Fortschrittsanzeige und Sprungmarke.
 *
 * Die Abschnitte meldet die Seite selbst über `data-kapitel="Name"`.
 */

const tb = `${traubenBox[0]} ${traubenBox[1]} ${traubenBox[2]} ${traubenBox[3]}`;

// Eine rankende Senkrechte mit zwei Locken — dieselbe Handschrift wie die
// Ranke im Logo, nur hochkant.
const rebe = `M20 0
  C 4 70 36 122 20 190
  C 9 238 30 252 26 234 C 22 214 6 226 12 252 C 18 278 34 288 20 342
  C 4 402 36 454 20 522
  C 6 572 34 624 20 692
  C 9 740 28 754 25 735 C 22 716 8 728 13 752 C 18 776 33 784 20 832
  C 6 890 34 942 20 1000`;
---

<nav class="begleiter" data-begleiter aria-label="Abschnitte dieser Seite" hidden>
  <svg class="begleiter__rebe" viewBox="0 0 40 1000" preserveAspectRatio="none" aria-hidden="true">
    <path class="begleiter__spur" d={rebe} />
    <path class="begleiter__wuchs" data-wuchs d={rebe} />
  </svg>

  <svg class="begleiter__vorrat" aria-hidden="true" width="0" height="0">
    <symbol id="begleiter-traube" viewBox={tb}>
      {trauben.map((d) => <path d={d} />)}
    </symbol>
  </svg>

  <ul class="begleiter__marken" data-marken></ul>
</nav>

<style>
  .begleiter {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 14px;
    z-index: 60;
    pointer-events: none;
  }

  @media (min-width: 62rem) {
    .begleiter { width: 56px; }
  }

  .begleiter[hidden] { display: none; }

  .begleiter__rebe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  .begleiter__spur { stroke: var(--linie); }
  .begleiter__wuchs { stroke: var(--rebe); }

  /* Auf dunklen Abschnitten dreht die Farbe. Wird per Skript gesetzt. */
  .begleiter[data-grund='dunkel'] .begleiter__spur { stroke: rgba(244, 241, 234, 0.18); }
  .begleiter[data-grund='dunkel'] .begleiter__wuchs { stroke: var(--paper); }

  .begleiter__vorrat { position: absolute; }

  .begleiter__marken { position: absolute; inset: 0; }

  /* Die Marken entstehen erst im Skript und tragen deshalb kein
     Astro-Scope-Attribut — diese Regeln müssen global sein. */
  .begleiter :global(.begleiter__marke) {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    pointer-events: auto;
  }

  .begleiter :global(.begleiter__punkt) {
    display: block;
    flex: none;
    max-width: none;
    width: 10px;
    height: 14px;
    color: var(--ink-40);
    transform: scale(0.5);
    transform-origin: center;
    transition:
      transform var(--d-ruhig) var(--e-aus),
      color var(--d-normal) var(--e-weich);
  }
  .begleiter :global(.begleiter__punkt path),
  .begleiter :global(.begleiter__punkt use) { fill: currentColor; }

  @media (min-width: 62rem) {
    .begleiter :global(.begleiter__punkt) { width: 14px; height: 20px; }
  }

  .begleiter :global(.begleiter__marke.ist-reif .begleiter__punkt) {
    transform: scale(1);
    color: var(--rebe);
  }

  .begleiter[data-grund='dunkel'] :global(.begleiter__punkt) { color: rgba(244, 241, 234, 0.3); }
  .begleiter[data-grund='dunkel'] :global(.begleiter__marke.ist-reif .begleiter__punkt) { color: var(--paper); }

  .begleiter :global(.begleiter__name) {
    font-size: var(--t-micro);
    font-variation-settings: 'wght' 600, 'wdth' 100;
    letter-spacing: var(--sperr-weit);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-60);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--d-normal) var(--e-aus),
      transform var(--d-normal) var(--e-aus);
  }

  .begleiter[data-grund='dunkel'] :global(.begleiter__name) { color: rgba(244, 241, 234, 0.7); }

  /* Nur der aktuelle Abschnitt zeigt seinen Namen — beim Überfahren alle. */
  .begleiter :global(.begleiter__marke.ist-hier .begleiter__name),
  .begleiter:hover :global(.begleiter__name),
  .begleiter :global(.begleiter__marke:focus-within .begleiter__name) {
    opacity: 1;
    transform: none;
  }

  .begleiter :global(.begleiter__ziel) {
    position: absolute;
    inset: -10px -6px;
    border-radius: 999px;
  }

  /* Auf schmalen Geräten nur die Rebe, keine Namen. */
  @media (max-width: 61.99rem) {
    .begleiter :global(.begleiter__name) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .begleiter :global(.begleiter__punkt),
    .begleiter :global(.begleiter__name) { transition: none; }
  }
</style>

<script>
  import { lenis } from '../lib/scroll';

  const begleiter = document.querySelector<HTMLElement>('[data-begleiter]');
  const wuchs = document.querySelector<SVGPathElement>('[data-wuchs]');
  const marken = document.querySelector<HTMLUListElement>('[data-marken]');

  if (begleiter && wuchs && marken) {
    const kapitel = Array.from(document.querySelectorAll<HTMLElement>('[data-kapitel]'));

    if (kapitel.length >= 2) {
      begleiter.hidden = false;

      const laenge = wuchs.getTotalLength();
      wuchs.style.strokeDasharray = `${laenge}`;
      wuchs.style.strokeDashoffset = `${laenge}`;

      // Für jedes Kapitel eine Traube an der passenden Höhe.
      const eintraege = kapitel.map((abschnitt, i) => {
        if (!abschnitt.id) abschnitt.id = `kapitel-${i + 1}`;

        const li = document.createElement('li');
        li.className = 'begleiter__marke';
        // Ohne Zwischen-Element: eine SVG mit `max-width: 100%` in einem
        // inline-Wrapper ohne eigene Breite kollabiert auf null.
        li.innerHTML = `
          <svg class="begleiter__punkt" viewBox="0 0 10 14" aria-hidden="true">
            <use href="#begleiter-traube" width="10" height="14" />
          </svg>
          <span class="begleiter__name">${abschnitt.dataset.kapitel ?? ''}</span>
          <a class="begleiter__ziel" href="#${abschnitt.id}">
            <span class="nur-sr">Zum Abschnitt ${abschnitt.dataset.kapitel ?? ''}</span>
          </a>`;
        marken.appendChild(li);
        return { abschnitt, li, anteil: 0 };
      });

      const messen = () => {
        const strecke = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        for (const e of eintraege) {
          // Wo im Dokument beginnt dieser Abschnitt?
          const oben = e.abschnitt.getBoundingClientRect().top + window.scrollY;
          e.anteil = Math.min(1, Math.max(0, oben / strecke));
          // Die Rebe füllt die Höhe, also sitzt die Marke auf demselben Anteil.
          e.li.style.top = `${e.anteil * 100}%`;
        }
      };

      let letzterGrund = '';
      const zeichnen = () => {
        const strecke = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const fortschritt = Math.min(1, Math.max(0, window.scrollY / strecke));

        wuchs.style.strokeDashoffset = `${laenge * (1 - fortschritt)}`;

        let aktiv = -1;
        for (let i = 0; i < eintraege.length; i++) {
          const reif = fortschritt >= eintraege[i].anteil - 0.005;
          eintraege[i].li.classList.toggle('ist-reif', reif);
          if (reif) aktiv = i;
        }
        eintraege.forEach((e, i) => e.li.classList.toggle('ist-hier', i === aktiv));

        // Untergrund auf halber Höhe abtasten, damit die Rebe auf dunklen
        // Sektionen nicht verschwindet. Die Leiste selbst zeigt keine
        // Treffer, sie hat pointer-events: none.
        const dunkleFelder = document.querySelectorAll<HTMLElement>(
          '.abschnitt--dunkel, .abschnitt--rebe, .seitenkopf, .fuss, .haltung',
        );
        const mitte = window.innerHeight / 2;
        let dunkel = false;
        for (const feld of dunkleFelder) {
          const r = feld.getBoundingClientRect();
          if (r.top <= mitte && r.bottom >= mitte) { dunkel = true; break; }
        }
        const grund = dunkel ? 'dunkel' : 'hell';
        if (grund !== letzterGrund) {
          begleiter.dataset.grund = grund;
          letzterGrund = grund;
        }
      };

      let laeuft = false;
      const anstossen = () => {
        if (laeuft) return;
        laeuft = true;
        requestAnimationFrame(() => { zeichnen(); laeuft = false; });
      };

      messen();
      zeichnen();

      if (lenis) lenis.on('scroll', anstossen);
      window.addEventListener('scroll', anstossen, { passive: true });
      window.addEventListener('resize', () => { messen(); zeichnen(); });
      // Nach dem Schriftladen stimmen die Höhen erst richtig.
      document.fonts?.ready.then(() => { messen(); zeichnen(); });
    }
  }
</script>
